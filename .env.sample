# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-luna

# NVIDIA Build API & Gemini
NVIDIA_API_KEY=your_nvidia_build_key
GEMINI_API_KEY=your_gemini_api_key

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=academic-paper-rag-chatbot

# Django Core & CORS
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-auto-generated-fallback-key-12345
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://skn33-project.store

# Remote MySQL Database
DB_NAME=paper_scholar
DB_USER=paper_scholar_app
DB_PASSWORD=your_password_here
DB_HOST=skn33.iptime.org
DB_PORT=33062

# RunPod FastAPI Inference Endpoint
RUNPOD_API_URL=http://localhost:8000